# Etherscan API key: https://etherscan.io/apidashboard
ETHERSCAN_API_KEY=YourEtherscanApiKeyToken
ETHERSCAN_API_BASE=https://api.etherscan.io/v2/api

# 6551/OpenTwitter API key: https://www.newsliquid.com/mcp or https://6551.io/mcp
OPENTWITTER_API_KEY=YourOpenTwitterToken

ALPHA_ETHERSCAN_REQUESTS_PER_SECOND=2
ALPHA_INTERVAL_SECONDS=1800
ALPHA_MAX_BLOCKS_PER_CYCLE=300
ALPHA_DISCOVERY_MODE=activity
ALPHA_ACTIVITY_MIN_OBSERVATIONS=100
ALPHA_ACTIVITY_INCLUDE_ALL_TRANSFERS=1
ALPHA_ACTIVITY_ALL_TRANSFER_LOG_SPAN=5
ALPHA_ENRICH_LIMIT_PER_CYCLE=10
ALPHA_REPORT_LIMIT_PER_CYCLE=0
ALPHA_REPORT_EVERY_ENRICHED=10

# Chain-specific overrides. The dashboard Settings page writes explicit
# ALPHA_ETHEREUM_*, ALPHA_BASE_*, and ALPHA_BSC_* values when saved.
# Global ALPHA_INTERVAL_SECONDS and ALPHA_MAX_BLOCKS_PER_CYCLE are treated
# as Ethereum defaults; Base/BSC use profile defaults unless overridden.
# ALPHA_ETHEREUM_INTERVAL_SECONDS=1800
# ALPHA_ETHEREUM_MAX_BLOCKS_PER_CYCLE=300
# ALPHA_ETHEREUM_DISCOVERY_MODE=activity
# ALPHA_ETHEREUM_ACTIVITY_MIN_OBSERVATIONS=100
# ALPHA_BASE_INTERVAL_SECONDS=1800
# ALPHA_BASE_MAX_BLOCKS_PER_CYCLE=300
# ALPHA_BASE_DISCOVERY_MODE=activity
# ALPHA_BASE_ACTIVITY_MIN_OBSERVATIONS=100
# ALPHA_BSC_INTERVAL_SECONDS=1800
# ALPHA_BSC_MAX_BLOCKS_PER_CYCLE=5000
# ALPHA_BSC_CONFIRMATIONS=64
# ALPHA_BSC_DISCOVERY_MODE=activity
# ALPHA_BSC_ACTIVITY_MIN_OBSERVATIONS=100
# Optional comma-separated event topic0 hashes for project-specific activity surfaces.
# The code has built-in sparse claim/mine/mint/reward topics, including
# Minted(address,uint256,bytes16,bytes32,uint256). Setting this overrides them.
# ALPHA_ACTIVITY_CUSTOM_EVENT_TOPICS=
